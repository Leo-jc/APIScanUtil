{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Leak scan 01-project result",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "scanner",
    "phase",
    "status",
    "summary",
    "input_scope",
    "outputs",
    "zero_results",
    "excluded",
    "failure_reason",
    "project_profile"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "scanner": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "const": "01-project"
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "failed",
        "zero"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "input_scope": {
      "type": [
        "object",
        "array",
        "string"
      ]
    },
    "outputs": {
      "type": [
        "object",
        "array"
      ]
    },
    "zero_results": {
      "type": "array"
    },
    "excluded": {
      "type": "array"
    },
    "failure_reason": {
      "type": "array"
    },
    "project_profile": {
      "type": "object",
      "required": [
        "project_type",
        "source_roots",
        "ohos_export_entries",
        "ohos_implementation_entries",
        "build_entries",
        "excluded_roots",
        "cross_language_boundary"
      ],
      "properties": {
        "project_type": {
          "type": "string",
          "minLength": 1
        },
        "source_roots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          }
        },
        "ohos_export_entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          }
        },
        "ohos_implementation_entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          }
        },
        "build_entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          }
        },
        "excluded_roots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          }
        },
        "cross_language_boundary": {
          "type": "object"
        },
        "code_scanner_result": {
          "type": "object",
          "required": ["status", "engines"],
          "properties": {
            "status": {
              "enum": ["completed", "partial", "failed", "not_applicable"]
            },
            "report_path": {
              "type": "string",
              "description": "report.json 的绝对路径"
            },
            "log_dir": {
              "type": "string",
              "description": "引擎日志目录的绝对路径"
            },
            "engines": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["tool_id", "status"],
                "properties": {
                  "tool_id": {
                    "type": "string",
                    "enum": ["homeflow", "cpp-agent"]
                  },
                  "status": {
                    "enum": ["completed", "failed", "timed_out", "not_applicable"]
                  },
                  "error": {
                    "type": "string"
                  },
                  "duration_ms": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "rule_hits": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["rule_id", "count"],
                      "properties": {
                        "rule_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "count": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "checklist_mapping": {
                          "type": "array",
                          "description": "该 rule 命中项映射到 checklist 的条目 ID",
                          "items": {
                            "type": "string",
                            "pattern": "^[A-Z][0-9]+$"
                          }
                        }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "zero"
          }
        }
      },
      "then": {
        "properties": {
          "zero_results": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "partial",
              "failed"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "failure_reason": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
