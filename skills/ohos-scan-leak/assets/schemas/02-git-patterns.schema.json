{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Leak scan 02-git-patterns result",
  "type": "object",
  "required": ["$schema", "schema_version", "scanner", "phase", "status", "summary", "input_scope", "outputs", "zero_results", "excluded", "failure_reason", "repository_error_rules", "candidates"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "scanner": {"type": "string", "minLength": 1},
    "phase": {"const": "02-git-patterns"},
    "status": {"enum": ["completed", "partial", "failed", "zero"]},
    "summary": {"type": "string", "minLength": 1},
    "input_scope": {"type": "object"},
    "outputs": {"type": "object"},
    "zero_results": {"type": "array"},
    "excluded": {"type": "array"},
    "failure_reason": {"type": "array"},
    "repository_error_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "rule", "change_type", "keywords", "evidence", "risk", "review_focus"],
        "properties": {
          "rule_id": {"type": "string", "minLength": 1},
          "rule": {"type": "string", "minLength": 1},
          "change_type": {"enum": ["problem_fix", "code_quality_maintenance"]},
          "keywords": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/location"}},
          "risk": {"type": "string", "minLength": 1},
          "review_focus": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "candidates": {"type": "array", "items": {"$ref": "#/$defs/pattern_candidate"}}
  },
  "$defs": {
    "location": {
      "type": "object",
      "required": ["file", "start_line"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "symbol": {"type": "string"},
        "snippet": {"type": "string"},
        "note": {"type": "string"}
      },
      "additionalProperties": true
    },
    "data_flow_step": {
      "type": "object",
      "required": ["sequence", "variable", "operation", "location", "before", "after", "effect"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "variable": {"type": "string", "minLength": 1},
        "operation": {"type": "string", "minLength": 1},
        "location": {"$ref": "#/$defs/location"},
        "before": {"type": "string"},
        "after": {"type": "string"},
        "effect": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "pattern_candidate": {
      "type": "object",
      "required": ["candidate_id", "scanner", "classification", "title", "summary", "location", "reachability", "behavior", "root_cause", "evidence", "provenance"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "scanner": {"type": "string", "minLength": 1},
        "classification": {
          "type": "object",
          "required": ["check_item", "check_direction", "severity", "error_type", "phenomenon", "mechanism", "confidence"],
          "properties": {
            "check_item": {"type": "string", "minLength": 1},
            "check_direction": {"type": "string", "minLength": 1},
            "severity": {"enum": ["critical", "high", "medium", "low", "info"]},
            "error_type": {"type": "string", "minLength": 1},
            "phenomenon": {"type": "string", "minLength": 1},
            "mechanism": {"type": "string", "minLength": 1},
            "origin": {"type": "string"},
            "confidence": {"type": "integer", "minimum": 0, "maximum": 100}
          },
          "additionalProperties": true
        },
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "location": {"$ref": "#/$defs/location"},
        "related_locations": {"type": "array", "items": {"$ref": "#/$defs/location"}},
        "reachability": {
          "type": "object",
          "required": ["public_entry", "prerequisites", "trigger_sequence", "state_requirements", "normal_usage_reason", "call_chain"],
          "properties": {
            "public_entry": {"type": "string", "minLength": 1},
            "prerequisites": {"type": "array"},
            "trigger_sequence": {"type": "array"},
            "state_requirements": {"type": "array"},
            "normal_usage_reason": {"type": "string", "minLength": 1},
            "call_chain": {"type": "array", "items": {"$ref": "#/$defs/location"}}
          },
          "additionalProperties": true
        },
        "behavior": {
          "type": "object",
          "required": ["expected", "actual", "impact"],
          "properties": {"expected": {"type": "string"}, "actual": {"type": "string", "minLength": 1}, "impact": {"type": "string", "minLength": 1}},
          "additionalProperties": true
        },
        "root_cause": {
          "type": "object",
          "required": ["explanation", "data_flow", "guards_checked", "fault_point"],
          "properties": {
            "explanation": {"type": "string", "minLength": 1},
            "data_flow": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/data_flow_step"}},
            "guards_checked": {"type": "array"},
            "fault_point": {"$ref": "#/$defs/location"}
          },
          "additionalProperties": true
        },
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/location"}},
        "provenance": {
          "type": "object",
          "required": ["history_lead_ids", "discovered_by_pattern_review", "merged_candidate_ids", "merge_reason"],
          "properties": {
            "history_lead_ids": {"type": "array", "items": {"type": "string"}},
            "discovered_by_pattern_review": {"const": true},
            "merged_candidate_ids": {"type": "array", "items": {"type": "string"}},
            "merge_reason": {"type": "string"}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "allOf": [
    {"if": {"properties": {"status": {"const": "zero"}}}, "then": {"properties": {"zero_results": {"minItems": 1}}}},
    {"if": {"properties": {"status": {"enum": ["partial", "failed"]}}}, "then": {"properties": {"failure_reason": {"minItems": 1}}}}
  ]
}
